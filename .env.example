# AI Container Orchestrator — 운영 환경 변수 예시
# 이 파일을 .env 로 복사한 뒤 필요한 값만 수정해서 사용하세요.
# Docker Compose 는 같은 디렉터리의 .env 를 자동으로 읽습니다.

# 서비스 상태(services.json, cluster.db)를 저장할 디렉터리
# Docker Compose 기본 설정에서는 /data 가 볼륨에 매핑되어 있어 재시작 후에도 유지됩니다.
ORCHESTRATOR_STATE_DIR=/data

# 노드 역할: master 또는 worker
# master: 클러스터 관리, 스케줄링, 마이그레이션 제어
# worker: 로컬 컨테이너 관리 + 마스터에 하트비트 전송
ORCHESTRATOR_ROLE=master

# (선택) /v1/* API 보호용 Bearer 토큰
# 설정하면 /v1/cluster/* 를 제외한 /v1/* 요청에 Authorization: Bearer <token> 이 필요합니다.
# ORCHESTRATOR_API_TOKEN=여기에_충분히_랜덤한_토큰_문자열

# === Worker 전용 설정 ===
# 마스터 노드 URL (worker 역할일 때 필수)
# ORCHESTRATOR_MASTER_URL=http://10.0.0.1:8000

# 이 노드의 이름 (기본: 호스트명)
# ORCHESTRATOR_NODE_NAME=node-a

# 하트비트 간격 (초, 기본: 10)
# ORCHESTRATOR_HEARTBEAT_INTERVAL=10

# (선택) 서브도메인 라우팅용 베이스 도메인
# 설정하면 서비스가 svc.도메인 형식으로 라우팅됩니다 (예: ai-insurance.itda.24x365.online)
# Cloudflare 등에서 *.도메인 와일드카드 DNS를 서버 IP로 등록해야 합니다.
# ORCHESTRATOR_BASE_DOMAIN=itda.24x365.online

# (선택) Google 로그인 — Google Cloud Console에서 "웹 애플리케이션" OAuth 클라이언트 생성
# 승인된 리디렉션 URI에 GOOGLE_OAUTH_REDIRECT_URL과 같은 값을 등록하세요.
# Traefik 뒤에서는 https 판별이 안 되므로 REDIRECT_URL을 반드시 명시합니다.
# GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URL=https://itda.24x365.online/v1/auth/google/callback
# GOOGLE_OAUTH_ALLOWED_DOMAIN=parametacorp.com
# 최초 로그인 시 admin 권한을 줄 이메일 (쉼표 구분, 나머지는 user)
# GOOGLE_OAUTH_ADMIN_EMAILS=
